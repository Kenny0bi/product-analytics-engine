# Product Analytics Engine — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Path to the DuckDB database file
PAE_DB_PATH=data/analytics.duckdb

# Data generation parameters
PAE_NUM_USERS=50000
PAE_TARGET_EVENTS=2000000
PAE_RANDOM_SEED=42

# API server configuration
PAE_API_HOST=0.0.0.0
PAE_API_PORT=8000
